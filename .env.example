# Used by Taskfile.yml (dotenv: [ .env ])
# Copy to .env and fill values locally.
# IMPORTANT: do not commit real tokens.

# Yandex Wiki API base URL (fixed by docs)
YANDEX_WIKI_BASE_URL=https://api.wiki.yandex.net

# Yandex Tracker API base URL
YANDEX_TRACKER_BASE_URL=https://api.tracker.yandex.net

# Yandex Cloud Organization ID for X-Cloud-Org-Id header
# Get via: yc organization-manager organization list
YANDEX_CLOUD_ORG_ID=

# Optional yc CLI profile for IAM token retrieval.
# If empty in local mode, yc uses the active profile. Required in remote mode.
YANDEX_CLI_PROFILE=

# Token refresh period in hours (default 10).
# The token adapter will refresh the IAM token after this period.
YANDEX_IAM_TOKEN_REFRESH_PERIOD=10

# Overall MCP tool timeout in seconds, including authentication and API retries.
YANDEX_MCP_TOOL_TIMEOUT=300

# local obtains tokens through yc on this machine; remote uses the workstation.
YANDEX_MCP_TOKEN_SOURCE=local
# Required in remote mode. YANDEX_CLI_PROFILE must also be explicit in remote mode.
YANDEX_MCP_AUTH_AGENT_URL=http://127.0.0.1:18765

# Workstation auth-agent settings. These do not require YANDEX_CLOUD_ORG_ID.
YANDEX_MCP_AUTH_AGENT_LISTEN=127.0.0.1:18765
# Absolute path to native yc, for example /usr/local/bin/yc or C:\Tools\yc.exe.
YANDEX_MCP_AUTH_AGENT_YC_PATH=
# Comma-separated allowed workstation profiles.
YANDEX_MCP_AUTH_AGENT_PROFILES=

# Used only by scripts/remote-auth/*/install.* during workstation setup.
YANDEX_MCP_BINARY=
YANDEX_MCP_SSH_TARGET=
YANDEX_MCP_REMOTE_PORT=18765

# Allowed attachment extensions (comma-separated, no dots).
# Fully replaces the default allowlist.
# Example: txt,json,html,pdf,tar.gz
YANDEX_MCP_ATTACH_EXT=

# Allowed attachment extensions for inline viewing (comma-separated, no dots).
# Fully replaces the default text allowlist.
# Example: txt,json,yaml,md,csv,tsv,rtf
YANDEX_MCP_ATTACH_VIEW_EXT=

# Maximum size in bytes for attachment content returned inline (default 10485760).
# Applies only to get_content inline responses.
YANDEX_MCP_ATTACH_INLINE_MAX_BYTES=10485760

# Allowed attachment directories (comma-separated, absolute paths).
# Fully replaces the default directory rules.
# Example: /Users/me/attachments,/Users/me/tmp
YANDEX_MCP_ATTACH_DIR=
