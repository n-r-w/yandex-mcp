# Used by Taskfile.yml (dotenv: [ .env ])
# Copy to .env and fill values locally.
# IMPORTANT: do not commit real tokens.

# Yandex Wiki API base URL (fixed by docs)
YANDEX_WIKI_BASE_URL=https://api.wiki.yandex.net

# Yandex Tracker API base URL
YANDEX_TRACKER_BASE_URL=https://api.tracker.yandex.net

# Organization: set exactly one of the two IDs.
# Yandex Cloud Organization ID for X-Cloud-Org-Id header
# Get via: yc organization-manager organization list
YANDEX_CLOUD_ORG_ID=
# Yandex 360 for Business organization ID for X-Org-Id header. Requires YANDEX_MCP_TOKEN_TYPE=oauth.
YANDEX_ORG_ID=

# yc CLI profile for IAM tokens.
# Optional for local IAM tokens: an empty value makes yc use the active profile. Required for remote IAM tokens.
YANDEX_CLI_PROFILE=

# Token refresh period in hours (default 10).
# The server refreshes the cached IAM or OAuth token after this period.
YANDEX_IAM_TOKEN_REFRESH_PERIOD=10

# Overall MCP tool timeout in seconds, including authentication and API retries.
YANDEX_MCP_TOOL_TIMEOUT=300

# Where the token is acquired: local on this machine, remote through the workstation auth-agent.
YANDEX_MCP_TOKEN_SOURCE=local
# Which token is acquired: iam through yc, oauth from a token file on this machine or through auth-agent.
YANDEX_MCP_TOKEN_TYPE=iam
# Absolute path to a file with one Yandex OAuth token. Required for local OAuth tokens.
YANDEX_OAUTH_TOKEN_FILE=
# OAuth profile name resolved by auth-agent to a token file. Required for remote OAuth tokens.
YANDEX_OAUTH_PROFILE=
# Loopback port: server-side tunnel port for MCP, listener port for auth-agent.
YANDEX_MCP_AUTH_AGENT_PORT=18765

# Optional workstation yc executable override, used only for IAM tokens. Default: yc from PATH.
# The installers save it; an explicit value that is not an executable stops installation.
YANDEX_MCP_AUTH_AGENT_YC_PATH=
# Optional absolute workstation directory with OAuth token files named after profiles.
# Default: the OAuth directory per operating system from README section Remote OAuth tokens. The installers save the value set at installation.
YANDEX_MCP_AUTH_AGENT_OAUTH_DIR=

# Required by workstation auth-agent: comma-separated SSH host aliases or user@host targets.
YANDEX_MCP_SSH_TARGETS=
# Optional installer override. Default: yandex-mcp from PATH.
YANDEX_MCP_BINARY=

# Allowed attachment extensions (comma-separated, no dots).
# Fully replaces the default allowlist.
# Example: txt,json,html,pdf,tar.gz
YANDEX_MCP_ATTACH_EXT=

# Allowed attachment extensions for inline viewing (comma-separated, no dots).
# Fully replaces the default text allowlist.
# Example: txt,json,yaml,md,csv,tsv,rtf
YANDEX_MCP_ATTACH_VIEW_EXT=

# Maximum size in bytes for attachment content returned inline (default 10485760).
# Applies only to get_content inline responses.
YANDEX_MCP_ATTACH_INLINE_MAX_BYTES=10485760

# Allowed attachment directories (comma-separated, absolute paths).
# Fully replaces the default directory rules.
# Example: /Users/me/attachments,/Users/me/tmp
YANDEX_MCP_ATTACH_DIR=
